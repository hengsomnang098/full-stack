{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=full_stack;Username=fullstack;Password=fullstack"
  },
  "Database": {
    "InitMode": "EnsureCreated"
  },
  "Jwt": {
    "Issuer": "FullStack.Api",
    "Audience": "FullStack.Client",
    "AccessSecret": "CHANGE_ME_access_secret_at_least_32_chars_long!",
    "RefreshSecret": "CHANGE_ME_refresh_secret_at_least_32_chars_long!",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "AccessCookieName": "access_token",
    "RefreshCookieName": "refresh_token"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Seed": {
    "Enabled": true,
    "AdminTel": "099998888",
    "AdminPassword": "Admin@12345",
    "AdminEmail": "admin@example.com"
  },
  "UploadPath": "wwwroot/uploads",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
